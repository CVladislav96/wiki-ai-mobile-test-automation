{
  "name": "wiki-ai-mobile-tests",
  "version": "1.0.0",
  "description": "Android UI tests for Wikipedia with WebdriverIO, Appium, Allure, visual checks, and an AI-assisted MCP workflow",
  "main": "index.js",
  "scripts": {
    "test": "npm run wdio",
    "wdio": "wdio run ./wdio.conf.ts",
    "postinstall": "patch-package",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "android-testing",
    "allure",
    "visual-testing",
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@gavrix/appium-mcp": "0.3.0",
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/visual-service": "^11.0.0",
    "allure-commandline": "2.46.1",
    "appium-uiautomator2-driver": "8.6.1",
    "expect-webdriverio": "^8.0.0",
    "patch-package": "8.0.1"
  }
}
